# Copy to .env for local use. Never commit the real .env.

# Comma-separated list of frontend origins allowed to call this API.
# Add your production Vercel URL here when you deploy.
ALLOWED_ORIGINS=http://localhost:3000

# Regex for Vercel preview deployments. Leave as is, or set to empty to disable.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# 1 = return fixture data instead of running the solver (for frontend development)
MOCK=0

# Where project JSON files are stored (local disk; free hosts may wipe this)
DATA_DIR=data

# Used by the hosting platform; local default is 8000
PORT=8000

# Solver limits for POST /generate
SOLVER_TIME_LIMIT=10
SOLVER_WORKERS=4
